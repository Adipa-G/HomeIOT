{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/homeiot.db"
  },
  "RuntimeControl": {
    "NextHeartbeatMs": 60000,
    "DevPollIntervalMs": 2000,
    "ModuleAssignmentPollIntervalMs": 60000
  },
  "DataRetention": {
    "RetentionDays": 30,
    "CleanupIntervalMinutes": 60
  },
  "OtaArtifacts": {
    "ArtifactRoot": "/app/artifacts"
  },
  "ModuleStorage": {
    "PackageRoot": "/app/modules"
  },
  "Jwt": {
    "SecretKey": "HomeIOT-Dev-Secret-Key-Change-In-Production-32chars!",
    "Issuer": "HomeIOT",
    "ExpirationHours": 24
  },
  "Admin": {
    "MasterUsername": "Admin",
    "MasterPassword": "123"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
