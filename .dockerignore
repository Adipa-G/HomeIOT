# Git files
.git
.gitignore
.gitattributes

# Build artifacts
bin
obj

# Node modules and build outputs (not needed for .NET build)
node_modules
web-ui/node_modules
web-ui/.pytest_cache
web-ui/dist

# Python virtual environment
.venv
venv
__pycache__

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
*.user
*.suo

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in runtime)
README.md
docs
*.md

# Test files (not needed in production image)
api/tests
edge/shared/tests
web-ui/src/test

# Local development files
*.log
*.tmp
.env
.env.local

# OTA artifacts and modules (will be mounted as volumes)
# Keep them out of image, use volume mounts instead
api/artifacts
api/modules
data

# Docker files
docker-compose.yml
Dockerfile
.dockerignore
